{
  "realm": "travel",
  "enabled": true,
  "displayName": "Voyager Travel",
  "loginTheme": "voyager",
  "accountTheme": "voyager",
  "adminTheme": "keycloak.v2",
  "emailTheme": "voyager",
  "registrationAllowed": true,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "smtpServer": {
    "host": "mailpit",
    "port": "1025",
    "from": "noreply@voyager.local",
    "fromDisplayName": "Voyager Local",
    "auth": "false",
    "ssl": "false",
    "starttls": "false"
  },
  "accessTokenLifespan": 900,
  "clients": [
    {
      "clientId": "voyager-api",
      "name": "Voyager API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"]
    },
    {
      "clientId": "voyager-frontend",
      "name": "Voyager Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "redirectUris": [
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+",
        "http://localhost:5173"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "google",
      "providerId": "google",
      "enabled": true,
      "updateProfileFirstLoginMode": "on",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "hideOnLogin": false,
      "firstBrokerLoginFlowAlias": "first broker login",
      "config": {
        "syncMode": "IMPORT",
        "clientId": "${KEYCLOAK_GOOGLE_CLIENT_ID}",
        "clientSecret": "${KEYCLOAK_GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "useJwksUrl": "true"
      }
    }
  ],
  "roles": {
    "realm": [
      {"name": "user", "description": "Default Voyager user role"},
      {"name": "admin", "description": "Voyager admin role"}
    ]
  },
  "users": [
    {
      "username": "voyager_user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Voyager",
      "lastName": "User",
      "email": "voyager_user@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "voyager_pass",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "default-roles-travel"]
    },
    {
      "username": "voyager_user_2",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Voyager",
      "lastName": "User Two",
      "email": "voyager_user_2@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "voyager_pass",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "default-roles-travel"]
    },
    {
      "username": "voyager_admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Voyager",
      "lastName": "Admin",
      "email": "voyager_admin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "voyager_pass",
          "temporary": false
        }
      ],
      "realmRoles": ["user", "admin", "default-roles-travel"]
    }
  ]
}
