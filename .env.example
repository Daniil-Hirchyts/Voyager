# Core
VOYAGER_DB_DSN=postgresql+asyncpg://voyager:voyager@db:5432/voyager
VOYAGER_REDIS_URL=redis://redis:6379/0
VOYAGER_KEYCLOAK_ISSUER=http://localhost:8080/realms/travel
VOYAGER_KEYCLOAK_AUDIENCE=voyager-api
VOYAGER_KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/travel/protocol/openid-connect/certs
VOYAGER_KEYCLOAK_CLIENT_ID=voyager-api
VOYAGER_KEYCLOAK_CLIENT_SECRET=

# Keycloak admin bootstrap
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
# Keycloak 26 also reads these as the canonical bootstrap names.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Required for the default Google identity provider imported into the travel realm.
KEYCLOAK_GOOGLE_CLIENT_ID=
KEYCLOAK_GOOGLE_CLIENT_SECRET=

# API runtime
VOYAGER_ENV=dev
VOYAGER_REQUIRE_IDEMPOTENCY_KEYS=true
VOYAGER_RATE_LIMIT_IP_PER_MIN=240
VOYAGER_RATE_LIMIT_USER_PER_MIN=120
VOYAGER_RATE_LIMIT_GENERATE_PER_HOUR=5
VOYAGER_RATE_LIMIT_PLACES_GEO_PER_MIN=60
VOYAGER_RATE_LIMIT_PLACES_AUTOCOMPLETE_PER_MIN=60
VOYAGER_RATE_LIMIT_PLACES_DEDUP_PER_HOUR=6
VOYAGER_RATE_LIMIT_ACTIVITIES_DISCOVER_PER_HOUR=240
VOYAGER_RATE_LIMIT_OPTIMIZE_SUBMIT_PER_HOUR=20
VOYAGER_RATE_LIMIT_OFFERS_SUBMIT_PER_HOUR=20
VOYAGER_RATE_LIMIT_EXPORT_SUBMIT_PER_HOUR=20
VOYAGER_RATE_LIMIT_AUDIT_READ_PER_MIN=120
VOYAGER_RATE_LIMIT_OFFERS_PROVIDER_PER_MIN=120
VOYAGER_RATE_LIMIT_ITINERARY_PROVIDER_PER_MIN=120
VOYAGER_LOG_LEVEL=INFO
VOYAGER_WORKER_POLL_INTERVAL_SEC=1
VOYAGER_JOB_MAX_ATTEMPTS=3
VOYAGER_EXPORTS_DIR=/var/lib/voyager/exports
VOYAGER_EXPORT_RETENTION_DAYS=14
VOYAGER_ACTIVITY_CACHE_TTL_SEC=30
VOYAGER_PROPOSAL_CACHE_TTL_SEC=30
VOYAGER_PLACE_PHOTO_CACHE_TTL_SEC=60
VOYAGER_EXPORT_CACHE_TTL_SEC=20
VOYAGER_AUDIT_CACHE_TTL_SEC=15

# Itinerary LLM provider strategy
VOYAGER_ITINERARY_LLM_ENABLED=true
VOYAGER_LLM_OPENROUTER_API_KEY=
VOYAGER_LLM_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
VOYAGER_LLM_OPENROUTER_MODEL_ORDER=stepfun/step-3.5-flash:free,z-ai/glm-4.5-air:free
VOYAGER_LLM_OPENROUTER_TIMEOUT_SEC=20

VOYAGER_LLM_MISTRAL_API_KEY=
VOYAGER_LLM_MISTRAL_BASE_URL=https://api.mistral.ai/v1
VOYAGER_LLM_MISTRAL_MODEL_ORDER=mistral-large-latest
VOYAGER_LLM_MISTRAL_TIMEOUT_SEC=20

VOYAGER_LLM_GEMINI_API_KEY=
VOYAGER_LLM_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
VOYAGER_LLM_GEMINI_MODEL_ORDER=gemini-2.5-flash,gemini-2.0-flash
VOYAGER_LLM_GEMINI_TIMEOUT_SEC=20

TRIPADVISOR_SCRAPER_API_KEY=
VOYAGER_ACTIVITIES_TRIPADVISOR_BASE_URL=https://tripadvisor-scraper-api.omkar.cloud/tripadvisor
VOYAGER_ACTIVITIES_TRIPADVISOR_TIMEOUT_SEC=20
VOYAGER_MEDIA_USER_AGENT=Voyager/0.1 (+https://localhost)
VOYAGER_PLACES_AUTOCOMPLETE_BASE_URL=https://photon.komoot.io/api
VOYAGER_PLACES_AUTOCOMPLETE_TIMEOUT_SEC=10
VOYAGER_PLACES_AUTOCOMPLETE_LANG=en
VOYAGER_GOOGLE_MAPS_API_KEY=
VOYAGER_GOOGLE_MAPS_LANGUAGE=en
VOYAGER_GOOGLE_MAPS_REGION=US
VOYAGER_GOOGLE_PLACES_TIMEOUT_SEC=10
VOYAGER_GOOGLE_ROUTES_TIMEOUT_SEC=12

# Frontend maps
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
VITE_GOOGLE_MAPS_LANGUAGE=en
VITE_GOOGLE_MAPS_REGION=US
